{
  "manifest_version": 3,
  "name": "KAAP Inkoop Radar hulp",
  "short_name": "KAAP hulp",
  "version": "1.0.0",
  "description": "Opent pagina's van mobile.de en Gaspedaal op de achtergrond en geeft de inhoud door aan de KAAP Inkoop Radar.",
  "minimum_chrome_version": "110",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://*.mobile.de/*",
    "https://*.gaspedaal.nl/*"
  ],
  "background": {
    "service_worker": "achtergrond.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kelliank98.github.io/KAAP_Portal/*"],
      "js": ["brug.js"],
      "run_at": "document_start"
    }
  ]
}
